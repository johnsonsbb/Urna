{
  "name": "covil",
  "private": true,
  "version": "0.1.0",
  "description": "Covil — idle MMORPG de navegador, estilo Tibia, com backend autoritativo e PWA instalável",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build:core": "pnpm --filter @covil/core build",
    "dev": "pnpm build:core && pnpm -r --parallel dev",
    "dev:server": "pnpm build:core && pnpm --filter @covil/server dev",
    "dev:web": "pnpm build:core && pnpm --filter @covil/web dev",
    "build": "pnpm build:core && pnpm --filter @covil/server build && pnpm --filter @covil/web build",
    "start": "pnpm --filter @covil/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "icons": "node scripts/gen-icons.mjs"
  }
}
