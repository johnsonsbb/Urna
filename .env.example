# Copie para .env e ajuste. Nunca comite o .env real.

# --- servidor ---
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Segredo de assinatura dos tokens JWT. Em produção use 64+ caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres

# Caminho do arquivo SQLite (relativo à raiz do repositório)
DATABASE_FILE=data/covil.sqlite

# Origens permitidas no CORS, separadas por vírgula.
# Só vale em produção — em desenvolvimento qualquer origem passa, para o jogo
# abrir pelo IP da rede local no celular sem configuração.
CORS_ORIGINS=https://seu-dominio.com

# --- web (build-time, prefixo VITE_) ---
# Deixe VAZIO para o cliente falar com a mesma máquina que serviu a página,
# na porta 3333. É o que faz funcionar tanto em localhost quanto pelo IP da
# rede. Preencha apenas quando a API estiver em outro domínio.
VITE_API_URL=
