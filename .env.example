# Copie para .env e ajuste. Nunca comite o .env real.

# --- servidor ---
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Segredo de assinatura dos tokens JWT. Em produção use 64+ caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres

# Caminho do arquivo SQLite (relativo à raiz do repositório)
DATABASE_FILE=data/urna.sqlite

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# --- web (build-time, prefixo VITE_) ---
VITE_API_URL=http://localhost:3333
